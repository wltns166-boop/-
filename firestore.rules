rules_version = '2';

// TEAM TOPS — Firestore 보안 규칙
// 앱이 익명 인증으로 로그인하므로, 인증된 세션만 데이터 읽기/쓰기 허용.
// (청구 메타데이터에 주민번호 등 민감정보가 포함되므로 인증 없는 접근을 차단)
// 예외: kakao_private 컬렉션(카카오 REST키·리프레시 토큰)은 서버(Cloud Functions Admin SDK) 전용 —
//       클라이언트 접근을 전면 차단한다 (Admin SDK는 보안규칙을 거치지 않으므로 서버 동작엔 영향 없음)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{doc=**} {
      allow read, write: if request.auth != null && col != 'kakao_private';
    }
  }
}
