{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      "**/.github/**",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "*.gs",
      "insurance-intranet-v2.html",
      "med-agents/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
