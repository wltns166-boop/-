# YouTube API 설정
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/youtube/auth/callback

# JWT 인증 키
JWT_SECRET=your-secret-key-change-this-in-production

# 쇼츠 폴더 경로 (환경에 맞게 설정)
# Windows 예시:
SHORTS_DIR=C:\Users\박지순\OneDrive\Desktop\인트라넷\쇼츠 업로드
# 또는 로컬 폴더:
# SHORTS_DIR=C:\Users\박지순\videos\shorts
# Mac/Linux 예시:
# SHORTS_DIR=/Users/박지순/OneDrive/Desktop/인트라넷/쇼츠 업로드
